                            'teams' => [
                                'home' => [
                                    'id' => 46,
                                    'name' => 'Barcelona',
                                ],
                                'away' => [
                                    'id' => 47,
                                    'name' => 'Real Madrid',
                                ],
                            ],
                            'goals' => [
                                'home' => 2,
                                'away' => 1,
                            ],
                        ],
                    ],
                ], 200);
            }

            // Check if it's a request for results (status=FT)
            if (isset($query['status']) && $query['status'] === 'FT') {
                return Http::response([
                    'response' => [
                        [
                            'fixture' => [
                                'id' => 126,
                                'timestamp' => strtotime('2026-08-25 20:00:00'),
                                'status' => [
                                    'short' => 'FT',
                                    'elapsed' => null,
                                ],
                            ],
                            'league' => [
                                'id' => 3,
                                'name' => 'Bundesliga',
                            ],
                            'teams' => [
                                'home' => [
                                    'id' => 48,
                                    'name' => 'Bayern Munich',
                                ],
                                'away' => [
                                    'id' => 49,
                                    'name' => 'Borussia Dortmund',
                                ],
                            ],
                            'goals' => [
                                'home' => 3,
                                'away' => 2,
                            ],
                        ],
                    ],
                ], 200);
            }

            // Otherwise, assume it's a regular fixtures request (getFixtures)
            return Http::response([
                'response' => [
                    [
                        'fixture' => [
                            'id' => 123,
                            'timestamp' => strtotime('2026-08-26 20:00:00'),
                            'status' => [
                                'short' => 'NS',
                                'elapsed' => null,
                            ],
                        ],
                        'league' => [
                            'id' => 1,
                            'name' => 'Premier League',
                        ],
                        'teams' => [
                            'home' => [
                                'id' => 42,
                                'name' => 'Arsenal',
                            ],
                            'away' => [
                                'id' => 43,
                                'name' => 'Liverpool',
                            ],
                        ],
                        'goals' => [
                            'home' => 1,
                            'away' => 0,
                        ],
                    ],
                    [
                        'fixture' => [
                            'id' => 124,
                            'timestamp' => strtotime('2026-08-26 22:00:00'),
                            'status' => [
                                'short' => '1H',
                                'elapsed' => 23,
                            ],
                        ],
                        'league' => [
                            'id' => 1,
                            'name' => 'Premier League',
                        ],
                        'teams' => [
                            'home' => [
                                'id' => 44,
                                'name' => 'Chelsea',
                            ],
                            'away' => [
                                'id' => 45,
                                'name' => 'Manchester City',
                            ],
                        ],
                        'goals' => [
                            'home' => 1,
                            'away' => 0,
                        ],
                    ],
                ],
            ], 200);
        });

        $from = CarbonImmutable::now()->subDay();
        $to = CarbonImmutable::now();

        // Act
        $result = $provider->getResults($from, $to);

        // Assert
        $this->assertInstanceOf(Collection::class, $result);
        $this->assertNotEmpty($result);
        $this->assertCount(1, $result);

        $fixture = $result->first();
        $this->assertInstanceOf(ProviderFixture::class, $fixture);
        $this->assertEquals('api-football', $fixture->provider);
        $this->assertEquals('126', $fixture->externalId);
        $this->assertEquals('3', $fixture->competitionExternalId);
        $this->assertEquals('Bundesliga', $fixture->competitionName);
        $this->assertEquals('48', $fixture->homeExternalId);
        $this->assertEquals('Bayern Munich', $fixture->homeName);
        $this->assertEquals('49', $fixture->awayExternalId);
        $this->assertEquals('Borussia Dortmund', $fixture->awayName);
        $this->assertEquals(CarbonImmutable::createFromTimestamp(strtotime('2026-08-25 20:00:00')), $fixture->kickoffAt);
        $this->assertEquals('finished', $fixture->statusCode); // FT -> finished
        $this->assertEquals(3, $fixture->homeScore);
        $this->assertEquals(2, $fixture->awayScore);
        $this->assertNull($fixture->minute); // minute is null for finished matches in our DTO
    }

    /** @test */
    public function getFixtures_returns_empty_collection_when_api_key_is_not_configured()
    {
        // Arrange
        // Temporarily set the API key to empty
        config(['services.api-football.key' => '']);
        $provider = new ApiFootballProvider();
        $from = CarbonImmutable::now()->subDay();
        $to = CarbonImmutable::now()->addDay();

        // Act
        $result = $provider->getFixtures($from, $to);

        // Assert
        $this->assertInstanceOf(Collection::class, $result);
        $this->assertTrue($result->isEmpty());
    }

    /** @test */
    public function getFixtures_returns_empty_collection_when_http_request_fails()
    {
        // Arrange
        $provider = new ApiFootballProvider();
        $from = CarbonImmutable::now()->subDay();
        $to = CarbonImmutable::now()->addDay();

        // Mock a failed HTTP response
        Http::fake([
            '*' => Http::response('', 500, []),
        ]);

        // Act
        $result = $provider->getFixtures($from, $to);

        // Assert
        $this->assertInstanceOf(Collection::class, $result);
        $this->assertTrue($result->isEmpty());
    }

    /** @test */
    public function getFixtures_returns_empty_collection_when_response_is_invalid()
    {
        // Arrange
        $provider = new ApiFootballProvider();
        $from = CarbonImmutable::now()->subDay();
        $to = CarbonImmutable::now()->addDay();

        // Mock an invalid HTTP response (missing 'response' key)
        Http::fake([
            '*' => Http::response(['foo' => 'bar'], 200, []),
        ]);

        // Act
        $result = $provider->getFixtures($from, $to);

        // Assert
        $this->assertInstanceOf(Collection::class, $result);
        $this->assertTrue($result->isEmpty());
    }
}