NEXT_PUBLIC_RIFITV_API_BASE=http://127.0.0.1:8000/api/v1
NEXT_PUBLIC_RIFITV_SITE_URL=http://127.0.0.1:3000

# ─── Master Ad Switch ────────────────────────────────────────────────────────
# Set to true in production to enable the full ad system.
# Keep false in development to avoid loading third-party scripts during dev.
NEXT_PUBLIC_RIFITV_ADS_ENABLED=false

# ─── Ad Category Switches ───────────────────────────────────────────────────
NEXT_PUBLIC_RIFITV_NORMAL_ADS_ENABLED=true       # Banners, native, sidebar
NEXT_PUBLIC_RIFITV_AGGRESSIVE_ADS_ENABLED=false  # Pop, vignette, direct-link
NEXT_PUBLIC_RIFITV_MOBILE_ADS_ENABLED=true
NEXT_PUBLIC_RIFITV_TABLET_ADS_ENABLED=true
NEXT_PUBLIC_RIFITV_DESKTOP_ADS_ENABLED=true
NEXT_PUBLIC_RIFITV_TV_ADS_ENABLED=false          # Always off — TV UX protection
NEXT_PUBLIC_RIFITV_PREWATCH_AD_ENABLED=true       # Pre-stream 10s gate
NEXT_PUBLIC_RIFITV_NATIVE_AD_ENABLED=true         # effectivecpmnetwork native

# ─── HighPerformanceFormat Banner Zone Switches ──────────────────────────────
NEXT_PUBLIC_RIFITV_HPF_728X90_ENABLED=true
NEXT_PUBLIC_RIFITV_HPF_468X60_ENABLED=true
NEXT_PUBLIC_RIFITV_HPF_320X50_ENABLED=true
NEXT_PUBLIC_RIFITV_HPF_160X600_ENABLED=true
NEXT_PUBLIC_RIFITV_HPF_160X300_ENABLED=true
NEXT_PUBLIC_RIFITV_HPF_300X250_ENABLED=true

# ─── effectivecpmnetwork Supplemental Scripts ────────────────────────────────
NEXT_PUBLIC_RIFITV_ECPM_SCRIPT1_ENABLED=true
NEXT_PUBLIC_RIFITV_ECPM_SCRIPT2_ENABLED=true
NEXT_PUBLIC_RIFITV_ECPM_DIRECT_ENABLED=true

# ─── Aggressive Zone Switches ────────────────────────────────────────────────
NEXT_PUBLIC_RIFITV_ZONE_248721_ENABLED=true
NEXT_PUBLIC_RIFITV_ZONE_11137945_ENABLED=true
NEXT_PUBLIC_RIFITV_ZONE_11137952_ENABLED=true    # Loads ONCE globally — dedup enforced
NEXT_PUBLIC_RIFITV_ZONE_11137954_ENABLED=true    # Vignette
NEXT_PUBLIC_RIFITV_ZONE_11137969_ENABLED=true    # Direct link (omg10)
NEXT_PUBLIC_RIFITV_ZONE_250801_ENABLED=true

# ─── Cooldowns (minutes) ─────────────────────────────────────────────────────
NEXT_PUBLIC_RIFITV_AGGRESSIVE_COOLDOWN=30        # General aggressive cooldown
NEXT_PUBLIC_RIFITV_POP_COOLDOWN=30               # onclick/pop cooldown
NEXT_PUBLIC_RIFITV_VIGNETTE_COOLDOWN=45          # Vignette cooldown
NEXT_PUBLIC_RIFITV_DIRECT_LINK_COOLDOWN=45       # Direct link cooldown
NEXT_PUBLIC_RIFITV_MAX_AGGRESSIVE_PER_SESSION=2  # Max aggressive events per session
NEXT_PUBLIC_RIFITV_MIDROLL_INTERVAL=30           # Minutes before mid-roll overlay

# ─── Timeouts (ms) ───────────────────────────────────────────────────────────
NEXT_PUBLIC_RIFITV_AD_SCRIPT_TIMEOUT_MS=5000
NEXT_PUBLIC_RIFITV_BANNER_TIMEOUT_MS=5000

# ─── UX ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_RIFITV_PREWATCH_SECONDS=10           # Pre-stream countdown length
NEXT_PUBLIC_RIFITV_STICKY_AUTO_HIDE_MS=30000     # Mobile sticky auto-hide (30s)
NEXT_PUBLIC_RIFITV_MIDROLL_DISPLAY_MS=18000      # Mid-roll overlay duration (18s)

NEXT_PUBLIC_APP_TIMEZONE=Africa/Casablanca